# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripforge?schema=public"

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
AUTH_SECRET="super-secret-key-change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers — leave both empty to run in demo mode (offline itinerary generator).
# Gemini is used when its key is set, otherwise OpenAI.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Optional model override, e.g. "gpt-4.1-mini" or "gemini-2.5-flash"
AI_MODEL=""

# Mapbox — without it the trip map falls back to an OpenStreetMap preview
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Weather and geocoding use Open-Meteo, which needs no key.
