generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------
// Authentication (Auth.js / NextAuth)
// ---------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?

  accounts        Account[]
  sessions        Session[]
  preferences     UserPreference?
  trips           Trip[]
  tripMemberships TripMember[]
  savedPlaces     SavedPlace[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------
// User Data & Preferences
// ---------------------------------------------

model UserPreference {
  id                 String @id @default(cuid())
  userId             String @unique
  travelStyle        String @default("Balanced") // Relaxed, Balanced, Fast-paced, Adventure
  budgetPreference   String @default("Mid-range") // Budget, Mid-range, Premium, Luxury
  walkingPreference  String @default("Moderate") // Minimal, Moderate, High
  transportPreference String @default("Public transport") // Walking, Public transport, Taxi, Rental car
  interests          String[] // Array of strings e.g. ["Food", "Nature", "Anime"]
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------
// Trips & Itinerary
// ---------------------------------------------

model Trip {
  id              String   @id @default(cuid())
  userId          String   // Primary owner
  title           String
  summary         String?  @db.Text
  startDate       DateTime
  endDate         DateTime
  budgetAmount    Float?
  budgetCurrency  String   @default("EUR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         TripMember[]
  destinations    Destination[]
  cities          City[]
  days            TripDay[]
  budget          Budget?
  hotels          Hotel[]
}

model TripMember {
  id       String @id @default(cuid())
  tripId   String
  userId   String
  role     String @default("viewer") // owner, editor, viewer

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Destination {
  id        String @id @default(cuid())
  tripId    String
  name      String // Country or region name
  latitude  Float?
  longitude Float?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model City {
  id          String @id @default(cuid())
  tripId      String
  name        String
  latitude    Float?
  longitude   Float?
  orderIndex  Int    @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripDay {
  id                String   @id @default(cuid())
  tripId            String
  date              DateTime
  city              String?
  estimatedDailyCost Float?
  walkingDistanceKm  Float?
  transportTimeMins  Int?

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]
}

model Activity {
  id                  String   @id @default(cuid())
  tripDayId           String
  name                String
  category            String   // Food, Attraction, Transport, etc.
  description         String?  @db.Text
  durationMinutes     Int      @default(60)
  estimatedCost       Float?
  latitude            Float?
  longitude           Float?
  recommendedStartTime String? // E.g., "09:00"
  orderIndex          Int      @default(0)

  tripDay             TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  transportToNext     TransportSegment? // Transport to the next activity
}

model TransportSegment {
  id              String @id @default(cuid())
  activityId      String @unique
  mode            String // Walk, Transit, Drive
  durationMinutes Int
  distanceKm      Float?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------
// Places (Hotels & Restaurants)
// ---------------------------------------------

model Hotel {
  id             String  @id @default(cuid())
  tripId         String
  name           String
  rating         Float?
  estimatedPrice Float?
  imageUrl       String?
  latitude       Float?
  longitude      Float?
  address        String?
  amenities      String[]

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id             String  @id @default(cuid())
  name           String
  cuisine        String?
  rating         Float?
  priceLevel     Int?    // 1-4
  latitude       Float?
  longitude      Float?
  address        String?
  estimatedCost  Float?
}

// ---------------------------------------------
// Budget
// ---------------------------------------------

model Budget {
  id             String @id @default(cuid())
  tripId         String @unique
  totalEstimated Float
  currency       String @default("EUR")

  trip  Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items BudgetItem[]
}

model BudgetItem {
  id            String @id @default(cuid())
  budgetId      String
  category      String // Flights, Hotels, Transport, Food, Activities, Shopping, Other
  name          String
  estimatedCost Float
  actualCost    Float?
  isPaid        Boolean @default(false)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------
// Saved Places
// ---------------------------------------------

model SavedPlace {
  id          String   @id @default(cuid())
  userId      String
  placeType   String   // Destination, Hotel, Restaurant, Attraction
  name        String
  latitude    Float?
  longitude   Float?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
